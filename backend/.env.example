# Copy to backend/.env (git-ignored) and fill in. Any ONE of these three
# unlocks live LLM replies on the chatbot (priority order: Gemini → Claude → scripted).
# The pipeline (extract/assess/recommend) uses Claude only.

# Free tier, no card required: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Pay-as-you-go: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ------- optional overrides -------
CODECLINIC_MODEL=claude-opus-5-5
CODECLINIC_GEMINI_MODEL=gemini-2.5-flash
# low | medium | high - medium balances quality and live-demo latency
CODECLINIC_EFFORT=medium
# 1 = always serve cached sample reports and scripted chat (offline demo)
CODECLINIC_DEMO_MODE=0
# 1 = server-side refusal fallback (beta); set 0 if your account rejects the beta header
CODECLINIC_FALLBACKS=1
