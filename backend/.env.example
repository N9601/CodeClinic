# Copy to backend/.env (git-ignored) and fill in.
ANTHROPIC_API_KEY=

# Optional overrides
CODECLINIC_MODEL=claude-opus-5-5
# low | medium | high - medium balances quality and live-demo latency
CODECLINIC_EFFORT=medium
# 1 = always serve cached sample reports (offline demo)
CODECLINIC_DEMO_MODE=0
# 1 = server-side refusal fallback (beta); set 0 if your account rejects the beta header
CODECLINIC_FALLBACKS=1
