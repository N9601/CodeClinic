<?xml version="1.0" encoding="utf-8"?>
<!-- LabTrack LIMS - production web.config (DEMO FIXTURE: fake credentials, do not reuse) -->
<configuration>
  <connectionStrings>
    <add name="LabTrackDb"
         connectionString="Data Source=10.20.4.15;Initial Catalog=LabTrack;User ID=labtrack_app;Password=LabTr@ck2014!"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="InstrumentDropPath" value="\\labfs01\instrument_drop\" />
    <add key="CoaExportPath" value="D:\LabTrack\CoA\" />
    <add key="SmtpRelay" value="10.20.1.25" />
    <add key="RequireESignatureOnApproval" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="20480" />
    <authentication mode="Windows" />
    <sessionState mode="InProc" timeout="60" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>
